[Unit]
Description=Heimdall — Bifrost bridge SPO daemon (treasury movement loop)
Documentation=https://github.com/lantr-io/heimdall
# No bitcoind dependency. heimdall posts Treasury Movements to Cardano and the
# watchtowers relay them to Bitcoin; `bitcoin.rpc_url` is unset by default and the
# daemon needs no Bitcoin node. (The NixOS module orders after a local
# bitcoind-watchtower.service because that particular host runs one — that is a
# property of that deployment, not of heimdall.)
After=network-online.target
Wants=network-online.target

# Give up after 5 failures inside 5 minutes and leave the unit in `failed`.
#
# Without this a misconfigured node restarts silently forever: RestartSec=10 is
# not shorter than systemd's default 10 s rate-limit window, so the default
# limiter never trips, `systemctl is-active` alternates activating/active, and
# `systemctl --failed` stays empty while the daemon is doing nothing at all.
# Measured: NRestarts just climbs. At RestartSec=10 a persistent fault trips this
# in under a minute, while a transient crash an hour apart never does.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=heimdall
Group=heimdall

# /var/lib/heimdall. Holds the per-epoch DKG signing share and the federation
# share (both written 0600) and the completed-peg-outs trie, so it must be
# private: systemd's StateDirectoryMode default is 0755, which is not good
# enough here.
StateDirectory=heimdall
StateDirectoryMode=0700
WorkingDirectory=/var/lib/heimdall

# Operator knobs and secrets that should not sit in a dpkg-tracked conffile —
# notably $HEIMDALL_MNEMONIC. Leading '-': start even if the file is absent.
EnvironmentFile=-/etc/default/heimdall

# $HEIMDALL_ARGS is unquoted on purpose: systemd word-splits a bare $VAR, so the
# operator can add flags (e.g. --broadcast) from /etc/default/heimdall without
# editing this unit. ${VAR} would NOT split and would pass one giant argument.
# `run-spo`, not `run-mover`. This unit calls itself the SPO daemon and must be
# one: run-mover builds and signs a movement in a SINGLE process, from a signing
# key reproduced off a constant seed, so on any bridge not deployed with that key
# its signatures verify against nothing. run-spo is the epoch loop that joins the
# DKG and co-signs with the rest of the roster (or, before the first DKG, with
# the federation) — heimdall's only distributed signing path.
ExecStart=/usr/bin/heimdall run-spo --config /etc/heimdall/heimdall.toml $HEIMDALL_ARGS

# on-failure, not always: the loop retries internally and does not return, so a
# clean exit means it was asked to stop and restarting would fight the operator.
# Crashes still restart.
Restart=on-failure
RestartSec=10

# Hardening — mirrors deploy/nixos/heimdall-mover.nix rather than inventing a
# second shape. (That module deploys the auto-MOVER, which is a different job
# from this unit's; only the sandboxing is shared.) ProtectSystem=strict makes the whole filesystem read-only except
# ReadWritePaths, so the state directory is the only thing the daemon can write.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/heimdall

[Install]
WantedBy=multi-user.target

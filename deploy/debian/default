# /etc/default/heimdall — environment for heimdall.service.
#
# Installed 0640 root:heimdall. Unlike /etc/heimdall/heimdall.toml this file is
# read by systemd, not parsed by heimdall, so it is the right place for secrets:
# dpkg does not diff it against a shipped version on upgrade.

# Extra arguments appended to:
#   /usr/bin/heimdall run-mover --config /etc/heimdall/heimdall.toml $HEIMDALL_ARGS
#
# --interval-secs is the poll CEILING, not the movement cadence: the mover follows
# the protocol's on-chain batch grid, so a shorter interval does not produce more
# movements, only more Blockfrost scans. 900 (15 min) matches the NixOS default.
#
# --broadcast is what makes the daemon actually POST the Treasury Movement it
# builds. Without it every tick is a dry run — which is the right way to watch a
# fresh install for a cycle before letting it spend.
HEIMDALL_ARGS="--interval-secs 900"

# Cardano wallet mnemonic. Precedence is: cardano.mnemonic in heimdall.toml >
# $HEIMDALL_MNEMONIC — so setting it here only takes effect while cardano.mnemonic
# stays commented out in /etc/heimdall/heimdall.toml. That is the intended
# arrangement: the seed lives here, not in the file dpkg tracks.
#HEIMDALL_MNEMONIC="word word word ..."
